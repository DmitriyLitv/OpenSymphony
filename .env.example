# Required tracker and target repository settings.
LINEAR_API_KEY=
LINEAR_PROJECT_SLUG=
TARGET_REPOSITORY_URL=git@github.com:example/target-repository.git

# Required browser protection. Generate the hash with:
# docker run --rm -it caddy:2.10.2-alpine caddy hash-password
OPENSYMPHONY_WEB_USER=operator
OPENSYMPHONY_WEB_PASSWORD_HASH=
OPENSYMPHONY_WEB_PORT=8080

# Optional GitHub token for gh and HTTPS Git access. Prefer a fine-grained token.
GITHUB_TOKEN=
GIT_AUTHOR_NAME=OpenSymphony Agent
GIT_AUTHOR_EMAIL=opensymphony@example.com

# Optional HTTP CONNECT proxy. Usually set CODEX_HTTPS_PROXY to http://host:port.
CODEX_HTTPS_PROXY=
CODEX_HTTP_PROXY=
NO_PROXY=127.0.0.1,localhost,opensymphony,web
# For a TLS-inspecting proxy, place the PEM file in the config volume first.
CODEX_CA_CERTIFICATE=

# Optional outside Coolify or for an intentional rollback. Use a full published
# Git commit SHA. Coolify supplies SOURCE_COMMIT automatically when this is empty.
OPENSYMPHONY_IMAGE_TAG=

# Runtime tuning. The Codex CLI version is pinned in Dockerfile and changing it
# requires a new image build through GitHub Actions.
RUST_LOG=info
