{
	admin off
}

:{$OPENSYMPHONY_WEB_PORT:8080} {
	encode zstd gzip

	@health path /healthz
	handle @health {
		reverse_proxy opensymphony:2468
	}

	handle {
		basic_auth {
			{$OPENSYMPHONY_WEB_USER} {$OPENSYMPHONY_WEB_PASSWORD_HASH}
		}

		handle /api/* {
			reverse_proxy opensymphony:2468 {
				flush_interval -1
			}
		}

		handle_path /app/* {
			root * /srv
			try_files {path} /index.html
			file_server
		}

		handle {
			redir /app/ 302
		}
	}
}
